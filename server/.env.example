# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:3010
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# AI providers — the model router only uses providers whose key is set.
# With none set, every request falls back to the deterministic local engine.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Paystack (NGN wallet funding) — https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Stripe (international card wallet funding) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Simplification: Stripe charges are USD; we convert to a NGN wallet credit
# using this fixed rate. Replace with a live FX rate lookup before real launch.
NGN_PER_USD=1600
